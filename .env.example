# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Usa a API do AI Studio, não a Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Opcionais (valores padrão entre parênteses)
# Modelo do agente principal (gemini-3.5-flash)
AURORA_MODELO_PRINCIPAL=
# Modelo dos especialistas (o mesmo do principal)
AURORA_MODELO_ESPECIALISTAS=
# Porta da API (8000)
AURORA_PORT=
